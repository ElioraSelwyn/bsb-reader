{"b":"Ps","n":"Psalms","c":2,"vc":12,"k":[["s","The Triumphant Messiah"],["r","(Acts 4:23–31)"],["q1",[1,"Why do the nations rage",{"n":1}]],["q2",["and the peoples plot in vain?"]],["q1",[2,"The kings of the earth take their stand"]],["q2",["and the rulers gather together,"]],["q1",["against the LORD"]],["q2",["and against His Anointed One:",{"n":2}]],["q1",[3,"“Let us break Their chains"]],["q2",["and cast away Their cords.”"]],["b"],["q1",[4,"The One enthroned in heaven laughs;"]],["q2",["the Lord taunts them."]],["q1",[5,"Then He rebukes them in His anger,"]],["q2",["and terrifies them in His fury:"]],["q1",[6,"“I have installed My King on Zion,"]],["q2",["upon My holy mountain.”"]],["b"],["q1",[7,"I will proclaim the decree"]],["q2",["spoken to Me by the LORD:"]],["q1",["“You are My Son;"]],["q2",["today I have become Your Father.",{"n":3}]],["q1",[8,"Ask Me, and I will make the nations Your inheritance,"]],["q2",["the ends of the earth Your possession."]],["q1",[9,"You will break them",{"n":4}," with an iron scepter;"]],["q2",["You will shatter them like pottery.",{"n":5},"”"]],["b"],["q1",[10,"Therefore be wise, O kings;"]],["q2",["be admonished, O judges of the earth."]],["q1",[11,"Serve the LORD with fear,"]],["q2",["and rejoice with trembling."]],["q1",[12,"Kiss the Son, lest He be angry"]],["q2",["and you perish in your rebellion,"]],["q2",["when His wrath ignites in an instant."]],["b"],["q1",["Blessed are all who take refuge in Him."]]],"f":[{"v":1,"s":[" Or ",{"i":"noisily assemble"},"; see ",{"x":"Revelation 11:18","t":"Rev.11.18"},"."]},{"v":2,"s":[" Cited in ",{"x":"Acts 4:25–26","t":"Acts.4.25"}]},{"v":7,"s":[" Literally ",{"i":"today I have begotten You"},"; cited in ",{"x":"Acts 13:33","t":"Acts.13.33"},", Hebrews 1:5, and Hebrews 5:5"]},{"v":9,"s":[" LXX ",{"i":"You will rule them "},"or ",{"i":"You will shepherd them"}]},{"v":9,"s":[" Cited in ",{"x":"Revelation 2:27","t":"Rev.2.27"},"; see also Revelation 12:5 and Revelation 19:15."]}]}