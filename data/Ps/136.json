{"b":"Ps","n":"Psalms","c":136,"vc":26,"k":[["s","His Loving Devotion Endures Forever"],["r","(2 Chronicles 7:1–3)"],["q1",[1,"Give thanks to the LORD, for He is good."]],["qr",["His loving devotion endures forever."]],["q1",[2,"Give thanks to the God of gods."]],["qr",["His loving devotion endures forever."]],["q1",[3,"Give thanks to the Lord of lords."]],["qr",["His loving devotion endures forever."]],["q1",[4,"He alone does great wonders."]],["qr",["His loving devotion endures forever."]],["q1",[5,"By His insight He made the heavens."]],["qr",["His loving devotion endures forever."]],["q1",[6,"He spread out the earth upon the waters."]],["qr",["His loving devotion endures forever."]],["q1",[7,"He made the great lights—"]],["qr",["His loving devotion endures forever."]],["q1",[8,"the sun to rule the day,"]],["qr",["His loving devotion endures forever."]],["q1",[9,"the moon and stars to govern the night."]],["qr",["His loving devotion endures forever."]],["q1",[10,"He struck down the firstborn of Egypt"]],["qr",["His loving devotion endures forever."]],["q1",[11,"and brought Israel out from among them"]],["qr",["His loving devotion endures forever."]],["q1",[12,"with a mighty hand and an outstretched arm."]],["qr",["His loving devotion endures forever."]],["q1",[13,"He divided the Red Sea",{"n":1}," in two"]],["qr",["His loving devotion endures forever."]],["q1",[14,"and led Israel through the midst,"]],["qr",["His loving devotion endures forever."]],["q1",[15,"but swept",{"n":2}," Pharaoh and his army into the Red Sea."]],["qr",["His loving devotion endures forever."]],["q1",[16,"He led His people through the wilderness."]],["qr",["His loving devotion endures forever."]],["q1",[17,"He struck down great kings"]],["qr",["His loving devotion endures forever."]],["q1",[18,"and slaughtered mighty kings—"]],["qr",["His loving devotion endures forever."]],["q1",[19,"Sihon king of the Amorites"]],["qr",["His loving devotion endures forever."]],["q1",[20,"and Og king of Ba